ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS builder

ARG UV_VERSION=0.7.3
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir "uv==${UV_VERSION}"
WORKDIR /src
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv sync --frozen --no-dev --extra lm-eval-service --no-editable

FROM ${BASE_IMAGE}
ARG LM_EVAL_COMMIT=8a07e1110d060de48cfc7a9a7987b7659060b60b
ARG SOURCE_REVISION=unknown
RUN test "${LM_EVAL_COMMIT}" = "8a07e1110d060de48cfc7a9a7987b7659060b60b" \
    && groupadd --gid 65532 lm-eval \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin lm-eval
ENV LM_EVAL_COMMIT=${LM_EVAL_COMMIT}
LABEL org.opencontainers.image.source="https://github.com/neuralmagic/nm-hard-tools" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.nm-hard-tools.lm-eval.revision="${LM_EVAL_COMMIT}"

COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/cache \
    HF_HOME=/tmp/huggingface \
    HF_DATASETS_CACHE=/tmp/huggingface/datasets
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["inference-hard-lm-eval-service"]
