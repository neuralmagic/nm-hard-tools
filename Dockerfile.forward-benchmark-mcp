FROM python:3.12-slim

ARG SOURCE_REVISION=unknown
ARG SOURCE_URL=https://github.com/neuralmagic/inference-hard-tools

LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

RUN groupadd --gid 65532 inference-hard \
    && useradd --uid 65532 --gid 65532 --no-create-home \
      --shell /usr/sbin/nologin inference-hard
WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
RUN pip install --no-cache-dir .

USER 65532:65532
EXPOSE 8001
ENTRYPOINT ["inference-hard-forward-benchmark-mcp"]
